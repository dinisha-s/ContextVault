# ==============================================================================
# ContextVault Environment Configuration Template
# Copy this file to `backend/.env` to customize your local instance.
# ==============================================================================

# Server Network Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Optional API Key Authentication
# If set, all endpoints require the header `X-API-Key: <your_key>`.
# Leave empty to run in local zero-config mode without authentication.
API_KEY=

# File Upload Size Limits
# Real hard cap enforced on stream reading to prevent memory exhaustion
MAX_UPLOAD_SIZE_MB=10

# Local Storage Paths (Relative to backend/ or absolute paths)
CHROMA_PERSIST_DIR=./data/chroma_db
UPLOAD_DIR=./data/uploads

# Embedding Model Configuration (HuggingFace / Sentence-Transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM Provider Selection
# Options:
#   auto       - Tries OpenAI if key exists, falls back to Ollama, then extractive
#   openai     - Strictly uses OpenAI (requires OPENAI_API_KEY)
#   ollama     - Strictly uses local Ollama
#   extractive - Offline zero-dependency extractive RAG (no LLM required)
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=15

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Allowed CORS Origins (Comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
